# TASK Flow SaaS local environment template.
# Copy to `.env` and replace every production secret before deploying.

# PostgreSQL connection used by the API and Prisma.
DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public"
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_PORT=5432

# JWT authentication. Use long, random values in production.
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption key for stored SMTP credentials. Use a long, random value in production.
SMTP_ENCRYPTION_KEY="change-me-in-production"

# Public storage URL used for generated attachment metadata links.
STORAGE_PUBLIC_BASE_URL="http://localhost:4000/storage"

# Frontend/API URLs and CORS origins.
NEXT_PUBLIC_API_URL="http://localhost:4000"
WEB_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000"
WEB_PORT=3000
API_PORT=4000

# Redis connection used by BullMQ queues.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
